# Backend-only Supabase credentials. Never use VITE_ prefixes here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_backend_only_supabase_secret_key
SUPABASE_ANON_KEY=your_public_supabase_anon_key

# Generate a strong value and keep it unchanged after users are registered.
PASSWORD_PEPPER=replace_with_a_stable_random_secret
REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGINS=http://localhost:5173,https://campusconnect-two-ivory.vercel.app
